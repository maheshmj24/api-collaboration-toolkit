meta {
    name: Creates List Of Users With Given Input Array
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/user/createWithList
  body: json
  auth: inherit
}
body:json {
  [{
    "firstName": "{{PLACEHOLDER}}",
    "username": "{{PLACEHOLDER}}",
    "phone": "{{PLACEHOLDER}}",
    "email": "{{PLACEHOLDER}}",
    "userStatus": 0,
    "id": 0,
    "lastName": "{{PLACEHOLDER}}",
    "password": "{{PLACEHOLDER}}"
  }]
}

settings {
  encodeUrl: true
  timeout: 0
}

