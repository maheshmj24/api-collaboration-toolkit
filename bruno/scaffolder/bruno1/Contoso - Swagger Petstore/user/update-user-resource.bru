meta {
    name: Update User Resource
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/user/{{username}}
  body: json
  auth: inherit
}
body:json {
  {
    "firstName": "{{PLACEHOLDER}}",
    "username": "{{PLACEHOLDER}}",
    "phone": "{{PLACEHOLDER}}",
    "email": "{{PLACEHOLDER}}",
    "userStatus": 0,
    "id": 0,
    "lastName": "{{PLACEHOLDER}}",
    "password": "{{PLACEHOLDER}}"
  }
}

vars:pre-request {
  username: {{PLACEHOLDER}}
}

settings {
  encodeUrl: true
  timeout: 0
}

